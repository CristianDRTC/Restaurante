@model List<Socio>
@{ ViewData["Title"] = "Socios"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Socios</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo socio</a>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<form method="get" class="mb-3 d-flex gap-2">
    <input name="buscar" value="@ViewData["Buscar"]" class="form-control" placeholder="Buscar por documento o nombre" />
    <button class="btn btn-outline-secondary">Buscar</button>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Documento</th>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th>Correo</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Documento</td>
                <td>@s.Nombres @s.Apellidos</td>
                <td>@s.Telefono</td>
                <td>@s.Correo</td>
                <td>
                    <span class="badge @(s.Activo ? "bg-success" : "bg-secondary")">
                        @(s.Activo ? "Activo" : "Inactivo")
                    </span>
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@s.IdSocio" class="btn btn-sm btn-outline-primary">Editar</a>
                    <form asp-action="CambiarEstado" asp-route-id="@s.IdSocio" method="post" class="d-inline">
                        <button class="btn btn-sm @(s.Activo ? "btn-outline-danger" : "btn-outline-success")">
                            @(s.Activo ? "Desactivar" : "Activar")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
