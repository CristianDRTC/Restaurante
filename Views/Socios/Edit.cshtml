@model Cliente
@{ ViewData["Title"] = "Editar cliente"; }

<h1 class="h3">Editar cliente</h1>

<form asp-action="Edit" asp-route-id="@Model.IdCliente" method="post">
    <input type="hidden" asp-for="IdCliente" />
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
